# Listen port (default 3000). Increase or change if another app uses the same port.
PORT=3000
HEARTBEAT_PATH=/health
FORWARD_TARGET_HEADER=x-forward-url
TRUSTED_IPS=127.0.0.1,::1
TRUST_PROXY=false
UPSTREAM_TIMEOUT_MS=30000
MAX_BODY_BYTES=10485760
LOG_LEVEL=info

# Used by docker-compose.yml (not read by the Node app)
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=10s
# Container log rotation (json-file driver), per container: up to LOG_MAX_FILE files of LOG_MAX_SIZE each
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
